# Copy this file to .env and replace the placeholder with your own key.
# Never commit the resulting .env file.
OPENAI_API_KEY=your_openai_api_key_here

# Optional: choose a different OpenAI model.
# OPENAI_MODEL=gpt-5.4-mini

# Optional alternative provider (OpenAI is preferred when both are set).
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
